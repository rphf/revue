# agentbox settings for revue, read by the `agentbox` CLI (github.com/rphf/agentbox). N = agent number.
PROJECT=revue
REPO_URL=https://github.com/rphf/revue.git

# Outbox/control-panel and revue review-server ports of agent N, identical inside and outside the container.
# Both are loopback-only (see compose.yml). revue needs no database or app port: it is a single pure-Go binary
# with an embedded UI and a file-backed store, and the review server it runs is the app.
# The 4xxx block keeps these off zenmaid-webapp's 3xxx ports, so revue agent N and webapp agent N run at once
# (both resolve to 127.0.0.1, so the port — not just the hostname — has to differ).
PORTS="OUT_PORT=4N90 REVUE_PORT=4N91"
