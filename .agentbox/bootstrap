#!/usr/bin/env bash
# revue project bootstrap — run by the harness bootstrap as `agent` in /workspace on every `agentbox up`, after
# the clone and the home overlay. Idempotent: sandbox-only files, toolchain, web deps, and a first build.
set -euo pipefail
cd /workspace

# .agentbox/ is committed, so the clone brings AGENT.md with it. .mcp.json is not in the repo — revue does not know
# about any harness — so put the copy from .agentbox/ in place and keep it out of git, so `git status` stays clean.
[ -f .mcp.json ] || cp .agentbox/mcp.json .mcp.json
# Excluded whoever wrote it, so `git status` stays clean even when it arrived some other way.
grep -qx '.mcp.json' .git/info/exclude 2>/dev/null || echo '.mcp.json' >> .git/info/exclude

echo "── mise install (go, node, golangci-lint from mise.toml)"
mise trust >/dev/null 2>&1 || true
mise install
hash -r

echo "── npm ci (web)"
(cd web && npm ci)

# A first build so bin/revue exists right away: PATH puts it ahead of the release build, so the review server runs
# the current tree from the start. Later ups skip it — the agent rebuilds after each change (see .agentbox/AGENT.md).
if [ ! -x bin/revue ]; then
  echo "── make build"
  make build
fi

echo "── ready: $(go version | awk '{print $3}'), node $(node -v), golangci-lint $(golangci-lint version 2>/dev/null | head -1)"
